# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# editors / IDE
.idea/
.vscode/

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# worktrees
.worktrees/
.claude/worktrees/

# claude code runtime state
.claude/*.lock

# bun (project uses pnpm exclusively)
bun.lock
bun.lockb

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.test-user.json
/e2e/.auth/

# superpowers brainstorm
.superpowers/

# career-scene intermediate PNGs: the app serves the webp (scenes.json
# imagePath points to .webp); the .png is just the pre-cwebp source. Track
# the webp, ignore the heavy png.
public/careers/scenes/*.png

# image re-render scratch: side-by-side trial output + resumable progress state
/public/_image2-trial/
/data/would-you-rather/rerender-state.json
